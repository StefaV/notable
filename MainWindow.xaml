<Window x:Class="Notes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Notes"
        mc:Ignorable="d"
        Title="Mini Notes" Height="600" Width="1000"
        WindowStartupLocation = "CenterScreen">
        
        <Window.Resources>
            <SolidColorBrush x:Key="Background" Color="#333333"/>
            <SolidColorBrush x:Key="Foreground" Color="#CCCCCC"/>
            <Style x:Key = "TrayButton" TargetType = "Button">
                <Setter Property = "Height" Value = "30"/>
                <Setter Property = "Width" Value = "50"/>
                <Setter Property = "BorderThickness" Value = "0"/>
                <Setter Property = "VerticalAlignment" Value = "Top"/>
            </Style>
        </Window.Resources>

    <Grid Background = "{StaticResource Background}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width = "100" />
            <ColumnDefinition Width = "*"/>
            <ColumnDefinition Width = "75"/>
            <ColumnDefinition Width = "75"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height = "50" />
            <RowDefinition Height = "*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row = "0" Grid.Column = "0" Grid.RowSpan = "2" BorderThickness = "0" BorderBrush = "{StaticResource Background}">

            <StackPanel x:Name = "NoteList" Background = "{StaticResource Foreground}">
            </StackPanel>

        </Border>

        <Border  Grid.Row = "0" Grid.Column = "1" Grid.ColumnSpan = "3" BorderThickness = "0" Background = "{StaticResource Background}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />     
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name = "NoteTitle"
                    Grid.Column = "0"
                    AcceptsReturn = "False"
                    TextWrapping = "Wrap"
                    BorderThickness = "0"
                    VerticalScrollBarVisibility = "Auto"
                    HorizontalScrollBarVisibility = "Auto"
                    Padding = "50,25,0,0"
                    FontSize = "20"
                    FontFamily = "SansSerif"
                    Background = "{StaticResource Background}"
                    Foreground = "{StaticResource Foreground}">
                </TextBox>

                <StackPanel Orientation = "Horizontal" HorizontalAlignment="Right" Grid.Column = "1">
                    <Button Content = "New" Style = "{StaticResource TrayButton}" Click = "New"/>
                    <Button Content = "Save" Style = "{StaticResource TrayButton}" Click = "Save"/>
                    <Button Content = "Delete" Style = "{StaticResource TrayButton}" Click = "Delete"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBox x:Name = "NoteContent"
                Grid.Row = "1"
                Grid.Column = "1"
                AcceptsReturn = "True"
                TextWrapping = "Wrap"
                BorderThickness = "0"
                VerticalScrollBarVisibility = "Auto"
                HorizontalScrollBarVisibility = "Auto"
                Padding = "50,25,50,25"
                FontSize = "16"
                FontFamily = "SansSerif"
                Background = "{StaticResource Background}"
                Foreground = "{StaticResource Foreground}"/>
    </Grid>
</Window>
