<Window x:Class="Notes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Notes"
        mc:Ignorable="d"
        Title="Notable" Height="600" Width="1000"
        WindowStartupLocation = "CenterScreen">
        
        <Window.Resources>
            <SolidColorBrush x:Key="Background" Color="#333333"/>
            <SolidColorBrush x:Key="Foreground" Color="#CCCCCC"/>
        </Window.Resources>

    <Grid Background = "{StaticResource Background}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width = "50" />
            <ColumnDefinition Width = "*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height = "50" />
            <RowDefinition Height = "*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row = "0" Grid.Column = "0" Grid.RowSpan = "2" BorderThickness = "0" BorderBrush = "{StaticResource Background}">

            <StackPanel  Background = "{StaticResource Foreground}">
                <Button Height = "50" BorderThickness = "0" Click = "Save">Save</Button>
                <Button Height = "50" BorderThickness = "0" Click = "Open">Open</Button>
            </StackPanel>

        </Border>

        <TextBox
            x:Name = "NoteTitle"
            Grid.Row = "0"
            Grid.Column = "1"
            AcceptsReturn = "False"
            TextWrapping = "Wrap"
            BorderThickness = "0"
            VerticalScrollBarVisibility = "Auto"
            HorizontalScrollBarVisibility = "Auto"
            Padding = "50,25,0,0"
            FontSize = "20"
            FontFamily = "SansSerif"
            Background = "{StaticResource Background}"
            Foreground = "{StaticResource Foreground}">

            
        </TextBox>

        <TextBox x:Name = "NoteContent"
                Grid.Row = "1"
                Grid.Column = "1"
                AcceptsReturn = "True"
                TextWrapping = "Wrap"
                BorderThickness = "0"
                VerticalScrollBarVisibility = "Auto"
                HorizontalScrollBarVisibility = "Auto"
                Padding = "50,25,50,25"
                FontSize = "16"
                FontFamily = "SansSerif"
                Background = "{StaticResource Background}"
                Foreground = "{StaticResource Foreground}"/>
    </Grid>
</Window>
